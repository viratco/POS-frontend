# ── Supabase (Project Settings → API Keys) ────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# "Publishable" key (or the legacy "anon" key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── App ───────────────────────────────────────────────────────────────────
# GST in basis points: 500 = 5%
NEXT_PUBLIC_GST_RATE_BPS=500
# Address encoded in table QR codes. Leave blank to use whatever address you open /qr from.
NEXT_PUBLIC_SITE_URL=

# ── Kitchen tablet ───────────────────────────────────────────────────────
# Same kitchen login as backend/.env (the secret link signs in with it)
KITCHEN_EMAIL=kitchen@soheeskitchen.in
KITCHEN_PASSWORD=change-me-kitchen
# Kitchen screen link is /k/<KITCHEN_SECRET>. At least 16 random characters.
KITCHEN_SECRET=
# Signs the cached staff-role cookie (server-only). openssl rand -hex 32
ROLE_COOKIE_SECRET=

# ── Kitchen WhatsApp alerts ───────────────────────────────────────────────
# console = just log (default). whatsapp = send via WhatsApp Cloud API.
NOTIFIER=console
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=new_kitchen_order
WHATSAPP_TEMPLATE_LANG=en
# Comma-separated, international format without + (e.g. 919812345678,919876543210)
WHATSAPP_RECIPIENTS=

# ── Printed bills ─────────────────────────────────────────────────────────
NEXT_PUBLIC_BUSINESS_NAME=Sohee's Kitchen
NEXT_PUBLIC_BUSINESS_LEGAL_NAME=
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_BUSINESS_PHONE=
NEXT_PUBLIC_GSTIN=
NEXT_PUBLIC_FSSAI=
NEXT_PUBLIC_BILL_FOOTER=Thank you! Visit again.
